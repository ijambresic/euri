{
  "compilerOptions": {
    "target": "es6",
    "module": "ES2015",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "outDir": "./js",
    "rootDir": "ts",
    "baseUrl": "./",
    "sourceMap": true,
    "noEmitOnError": false
  },
  "include": ["ts/**/*.ts"]
}
