    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/mongodb": "^4.0.7",
    "@types/node": "^20.11.20",
    "eslint": "^10.14.0",
    "ncp": "^2.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.2"
